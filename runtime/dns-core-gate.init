#!/bin/sh /etc/rc.common
START=98
STOP=01
USE_PROCD=1
start_service() {
    /usr/libexec/dnsctl boot || return 78
    procd_open_instance monitor
    procd_set_param command /usr/libexec/dnsctl watch
    procd_set_param user root
    procd_set_param group root
    procd_set_param respawn 300 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    # Stopping the monitor does not dismantle DNS protection or the app core.
    :
}
