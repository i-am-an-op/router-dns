#!/bin/sh /etc/rc.common
# Optional Compose dependency only. Never calls the stock dockerd UCI helpers.
START=97
STOP=02
USE_PROCD=1
start_service() {
    local config=/etc/dns-core/daemon.host.json
    test -s "$config" || return 78
    /usr/bin/dockerd --validate --config-file "$config" >/dev/null 2>&1 || return 78
    procd_open_instance engine
    procd_set_param command /usr/bin/dockerd --config-file "$config"
    procd_set_param user root
    procd_set_param group root
    procd_set_param respawn 300 5 3
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
